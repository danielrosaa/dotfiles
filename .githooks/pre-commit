#!/bin/sh

# Non-destructive: after committing, ignored changes
# won't get erased.
# Markers:
#
# GITIGNORE_START
# lines here
# will be
# ignored
# GITIGNORE_END

set -e

tmpdir=$(mktemp -d)

cleanup() {
  rm -rf "$tmpdir"
}

trap cleanup EXIT

files=$(git diff --cached --name-only --diff-filter=ACM)

for file in $files; do
  [ -f "$file" ] || continue

  case "$file" in
    .githooks/*|.git/hooks/*)
      continue
      ;;
  esac

  cp "$file" "$tmpdir/original"

  sed '/# GITIGNORE_START/,/# GITIGNORE_END/d' "$file" > "$tmpdir/clean"

  cp "$tmpdir/clean" "$file"
  git add "$file"

  cp "$tmpdir/original" "$file"
done

exit 0
